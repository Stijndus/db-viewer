{
  "name": "db-viewer",
  "version": "0.12.9",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "concurrently -k -n ng,electron -c blue,green \"ng serve --port 4200\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on http://localhost:4200 && cross-env DB_VIEWER_DEV_URL=http://localhost:4200 electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "ng build && npm run build:electron",
    "start:prod": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.electron.json && tsc -p tsconfig.app.json --noEmit",
    "test": "npm run test:electron && ng test --watch=false",
    "test:electron": "vitest run --config vitest.electron.config.mts",
    "test:integration": "cross-env MYSQL_TEST_HOST=127.0.0.1 PG_TEST_HOST=127.0.0.1 MSSQL_TEST_HOST=127.0.0.1 vitest run --config vitest.electron.config.mts integration"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.8.11",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.6",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  },
  "description": "Database viewer met Angular, Electron en Node.js",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "io.github.stijndus.dbviewer",
    "productName": "DB Viewer",
    "copyright": "Copyright © 2026 Stijndus",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/db-viewer/browser/**",
      "dist-electron/**",
      "!dist-electron/**/*.map",
      "package.json",
      "!node_modules/ssh2/lib/protocol/crypto/build/**",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraFiles": [
        {
          "from": "build/db-viewer.cmd",
          "to": "db-viewer.cmd"
        }
      ],
      "files": [
        "!node_modules/7zip-bin/mac/**",
        "!node_modules/7zip-bin/linux/**",
        "!node_modules/7zip-bin/win/ia32/**",
        "!node_modules/7zip-bin/win/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DB Viewer",
      "artifactName": "DB-Viewer-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "DB-Viewer-${version}-portable.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "files": [
        "!node_modules/7zip-bin/mac/**",
        "!node_modules/7zip-bin/win/**"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Stijndus",
        "repo": "db-viewer",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ]
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "author": "Stijndus"
}
